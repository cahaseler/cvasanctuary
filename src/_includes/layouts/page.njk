---
layout: layouts/base.njk
---

<section class="simple-hero">
  <div class="container">
    <h1>{{ title }}</h1>
    {% if description %}
    <p class="simple-hero-subtitle">{{ description }}</p>
    {% endif %}
  </div>
</section>

<section class="simple-content">
  <div class="container">
    <div class="simple-content-wrapper">
      {{ content | safe }}
    </div>
  </div>
</section>

<style>
.simple-hero {
  background: linear-gradient(135deg, #4a7c59 0%, #6b9e77 100%);
  color: white;
  padding: 4rem 0;
}

.simple-hero h1 {
  color: white;
  margin: 0;
  text-align: center;
}

.simple-hero-subtitle {
  color: rgba(255, 255, 255, 0.95);
  max-width: 900px;
  margin: 1rem auto 0;
  text-align: center;
}

.simple-content {
  padding: 3rem 0 5rem;
  background: var(--color-bg);
}

.simple-content-wrapper {
  max-width: 900px;
  margin: 0 auto;
  background: white;
  padding: 2rem;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
</style>
